DATABASE_URL="file:./dev.db"
VOTE_TOTAL_LIMIT=5

# Prisma 引擎下载镜像（国内网络建议保留；海外可删除本行）
PRISMA_ENGINES_MIRROR="https://npmmirror.com/mirrors/prisma"

# 微信服务号 OAuth（生产环境必填）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3000/api/auth/wechat/callback

# Session 与 OAuth state 签名（生产环境请改为随机长字符串）
AUTH_SECRET=change-me-to-a-random-string

# 强制微信登录（默认 true；仅本地调试可设 false）
REQUIRE_WECHAT_LOGIN=true

# 开发模拟微信 openid（仅 NODE_ENV!=production 且设为 true 时生效）
ALLOW_DEV_LOGIN=true

# 管理员专用账号（仅此账号可见导航「管理」入口）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=moe-admin-2026

WJ_WEBHOOK_SECRET=
